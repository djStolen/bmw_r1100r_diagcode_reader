{
    "name": "Arduino Nano Ubuntu Dev Environment",
    "dockerFile": "Dockerfile",
    
    // Add useful VS Code extensions for Arduino development
    "customizations": {
        "vscode": {
            "extensions": [
                "vsciot-vscode.vscode-arduino",
                "ms-vscode.cpptools",
                "twxs.cmake",
                "lintangwisesa.arduino"
            ]
        }
    },

    // CRITICAL FOR HARDWARE: Grants the container permission to access USB serial ports
    "runArgs": [
        "--privileged",
        "-v", "/dev:/dev",
        "-v", "${localEnv:HOME}/.ssh:/root/.ssh:ro"
    ],

    // Ensures the workspace files are owned by the container user if needed
    "remoteUser": "root"
}

