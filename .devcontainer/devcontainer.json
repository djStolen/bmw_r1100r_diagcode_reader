{
    "name": "Arduino Nano Ubuntu Dev Environment",
    "dockerFile": "Dockerfile",
    
    "customizations": {
        "vscode": {
            "extensions": [
                "vsciot-vscode.vscode-arduino",
                "ms-vscode.cpptools",
                "lintangwisesa.arduino",
                "twxs.cmake"
            ]
        }
    },

    "runArgs": [
        "--privileged",
        "-v", "/dev:/dev",
        // Mounts host SSH keys straight into the new 'ubuntu' user home space
        "-v", "${localEnv:HOME}/.ssh:/home/ubuntu/.ssh"
    ],

    // SWITCH HERE: Stop using root, use the standard ubuntu user
    "remoteUser": "ubuntu"
}
